{
  "name": "brain-tumor-mri-classification",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Brain Tumor MRI Classification and Explainability Web Platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"magenta.bold,cyan.bold\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:api": "powershell -ExecutionPolicy Bypass -Command \"& .\\venv\\Scripts\\python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000\"",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "streamlit": "powershell -ExecutionPolicy Bypass -Command \"& .\\venv\\Scripts\\python -m streamlit run app.py\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}